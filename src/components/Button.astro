---
/*
  Button — zwei Gewichtungen, mit vollstaendigen Zustaenden.
  Fehlende Hover-Zustaende sind laut webdesign-Skill ein Billig-Indikator,
  darum sind sie hier eingebaut und nicht pro Seite von Hand.

  Rendert <a> wenn href gesetzt ist, sonst <button>.
*/
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  class: klass = '',
  ...rest
} = Astro.props;

const base =
  'inline-block px-5 py-3 text-sm font-semibold transition-colors duration-150 ' +
  'focus-visible:outline-3 focus-visible:outline-offset-2';

const variants = {
  primary: 'bg-accent text-ink hover:bg-ink hover:text-accent',
  secondary: 'border border-ink text-ink hover:bg-ink hover:text-base',
};

const Tag = href ? 'a' : 'button';
---
<Tag
  href={href}
  type={href ? undefined : type}
  class:list={[base, variants[variant], klass]}
  {...rest}
>
  <slot />
</Tag>
